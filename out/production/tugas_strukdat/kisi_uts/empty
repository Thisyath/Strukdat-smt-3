 * UTS Struktur Data - Sistem Manajemen Request Alokasi Energi
 * Implementasi Sorted Singly Linked List dengan operasi insert, delete, merge, dan search
 */
import java.util.ArrayList;

class Request implements Comparable<Request> {
    private String operator;      // Nama operator ritel
    private String ticketNumber;  // Nomor tiket format "APP-XXXXX"
    private String commodity;     // Jenis komoditas energi
    private int allocationYear;   // Tahun alokasi

    // Constructor untuk inisialisasi semua field Request
    public Request(String operator, String ticketNumber, String commodity, int allocationYear) {
        this.operator = operator;
        this.ticketNumber = ticketNumber;
        this.commodity = commodity;
        this.allocationYear = allocationYear;
    }

    // Getter untuk ticketNumber
    public String getTicketNumber() { return ticketNumber; }

    // Getter untuk operator
    public String getOperator() { return operator; }

    // Getter untuk commodity
    public String getCommodity() { return commodity; }

    // Getter untuk allocationYear
    public int getAllocationYear() { return allocationYear; }

    // [SOAL 1.1] Method untuk mengambil nilai numerik dari ticketNumber
    private int numericTicket() {
        // Cari posisi karakter '-' dalam ticketNumber
        int dashIndex = ticketNumber.indexOf('-');

        // Ambil substring setelah '-' (bagian angka)
        String numericPart = ticketNumber.substring(dashIndex + 1);

        // Konversi string angka ke integer dan return
        return Integer.parseInt(numericPart);
    }

    // [SOAL 1.1] Implementasi compareTo untuk sorting ascending berdasarkan nilai numerik
    @Override
    public int compareTo(Request o) {
        // Bandingkan nilai numerik tiket this dengan tiket o
        // Return negatif jika this < o, 0 jika sama, positif jika this > o
        return Integer.compare(this.numericTicket(), o.numericTicket());
    }

    // [SOAL 1.2] Implementasi toString dengan format yang diminta
    @Override
    public String toString() {
        // Format: "Operator - Commodity (TicketNumber) - AllocationYear"
        return operator + " - " + commodity + " (" + ticketNumber + ") - " + allocationYear;
    }
}

// Class Node untuk menyimpan data Request dan pointer ke node berikutnya
class Node {
    Request data;  // Data request pada node ini
    Node next;     // Pointer ke node berikutnya

    // Constructor untuk membuat node baru dengan data Request
    Node(Request d) {
        this.data = d;
        this.next = null;  // Inisialisasi next sebagai null
    }
}

class SortedLinkedList {
    private Node head;  // Pointer ke node pertama dalam linked list

    // Constructor untuk inisialisasi linked list kosong
    public SortedLinkedList() {
        this.head = null;
    }

    // [SOAL 2] Method untuk menyisipkan Request secara terurut
    // Return true jika node baru ditambahkan, false jika replace duplikat atau input null
    public boolean insertRequest(Request r) {
        // [SOAL 2.1] Null handling - cek jika request null
        if (r == null) {
            return false;  // Abaikan null dan return false
        }

        // Inisialisasi pointer untuk traversal
        Node prev = null;      // Pointer untuk node sebelumnya
        Node curr = head;      // Pointer untuk node saat ini, mulai dari head

        // Traversal untuk mencari posisi insert atau duplikat
        while (curr != null) {
            // Bandingkan request baru dengan data di curr menggunakan compareTo
            int comparison = r.compareTo(curr.data);

            // Jika compareTo return 0, berarti ticketNumber sama (duplikat)
            if (comparison == 0) {
                // Replace data pada node yang sudah ada dengan data baru
                curr.data = r;
                return false;  // Return false karena tidak menambah node baru
            }

            // Jika compareTo return negatif, posisi insert sudah ditemukan
            if (comparison < 0) {
                break;  // Keluar dari loop, posisi insert ada sebelum curr
            }

            // Lanjutkan traversal ke node berikutnya
            prev = curr;
            curr = curr.next;
        }

        // Buat node baru dengan request r
        Node newNode = new Node(r);

        // Cek apakah insert di awal list (head) atau list masih kosong
        if (prev == null) {
            // Insert di posisi head
            newNode.next = head;  // Node baru menunjuk ke head lama
            head = newNode;       // Update head ke node baru
        } else {
            // Insert di tengah atau akhir list
            newNode.next = prev.next;  // Node baru menunjuk ke node setelah prev
            prev.next = newNode;       // Prev menunjuk ke node baru
        }

        return true;  // Return true karena berhasil menambah node baru
    }

    // [SOAL 3] Method untuk menghapus node berdasarkan ticketNumber
    // Return true jika berhasil dihapus, false jika tidak ditemukan
    public boolean removeByTicket(String ticket) {
        // Cek jika list kosong
        if (head == null) {
            return false;  // Tidak ada yang bisa dihapus
        }

        // Case khusus: jika node yang dihapus adalah head
        if (head.data.getTicketNumber().equals(ticket)) {
            head = head.next;  // Pindahkan head ke node berikutnya
            return true;       // Return true karena berhasil menghapus
        }

        // Traversal untuk mencari node dengan ticketNumber yang cocok
        Node prev = head;      // Mulai dari head
        Node curr = head.next; // Node yang akan dicek

        // Loop sampai menemukan node dengan ticket yang cocok atau sampai akhir list
        while (curr != null) {
            // Cek apakah ticketNumber pada curr cocok dengan yang dicari
            if (curr.data.getTicketNumber().equals(ticket)) {
                // Hapus curr dengan mengubah pointer prev
                prev.next = curr.next;  // Prev skip curr, langsung ke next
                return true;            // Return true karena berhasil menghapus
            }
            // Lanjutkan traversal
            prev = curr;
            curr = curr.next;
        }

        return false;  // Return false jika tidak ditemukan
    }

    // [SOAL 4] Method untuk menggabungkan dua sorted linked list secara in-place
    // List 'other' akan menjadi kosong setelah proses merge
    public void mergeFrom(SortedLinkedList other) {
        // Cek jika other null atau kosong
        if (other == null || other.head == null) {
            return;  // Tidak ada yang perlu digabung
        }

        // Buat dummy node untuk mempermudah proses merge
        Node dummy = new Node(null);  // Node dummy tanpa data
        Node tail = dummy;            // Pointer untuk tail dari hasil merge

        // Pointer untuk traversal kedua list
        Node curr1 = this.head;    // Pointer untuk list saat ini (this)
        Node curr2 = other.head;   // Pointer untuk list other

        // Merge kedua list selama keduanya masih ada node
        while (curr1 != null && curr2 != null) {
            // Bandingkan data pada kedua node
            int comparison = curr1.data.compareTo(curr2.data);

            if (comparison < 0) {
                // Node dari list this lebih kecil, ambil dari this
                tail.next = curr1;  // Tambahkan curr1 ke hasil
                curr1 = curr1.next; // Maju ke node berikutnya di this
            } else if (comparison > 0) {
                // Node dari list other lebih kecil, ambil dari other
                tail.next = curr2;  // Tambahkan curr2 ke hasil
                curr2 = curr2.next; // Maju ke node berikutnya di other
            } else {
                // Duplikat ditemukan (comparison == 0)
                // Pertahankan data dari this, skip node dari other
                tail.next = curr1;  // Ambil node dari this
                curr1 = curr1.next; // Maju di this
                curr2 = curr2.next; // Skip node duplikat di other
            }

            // Pindahkan tail ke node terakhir yang ditambahkan
            tail = tail.next;
        }

        // Tambahkan sisa node dari list yang masih ada
        if (curr1 != null) {
            // Jika masih ada node di this, sambungkan sisanya
            tail.next = curr1;
        } else {
            // Jika masih ada node di other, sambungkan sisanya
            tail.next = curr2;
        }

        // Update head dari this dengan hasil merge (skip dummy node)
        this.head = dummy.next;

        // Kosongkan list other sesuai ketentuan
        other.head = null;
    }

    // [SOAL 5] Method untuk mencari semua request berdasarkan tahun tertentu
    // Return ArrayList berisi semua request dengan allocationYear yang sesuai
    public ArrayList<Request> findByYear(int year) {
        // Buat ArrayList untuk menyimpan hasil
        ArrayList<Request> res = new ArrayList<>();

        // Traversal seluruh linked list
        Node curr = head;  // Mulai dari head
        while (curr != null) {
            // Cek apakah allocationYear node saat ini sama dengan year yang dicari
            if (curr.data.getAllocationYear() == year) {
                // Jika cocok, tambahkan request ke ArrayList
                res.add(curr.data);
            }
            // Lanjutkan ke node berikutnya
            curr = curr.next;
        }

        // Return ArrayList berisi semua request di tahun tersebut
        return res;
    }

    // [SOAL 6] Method untuk menampilkan semua request dalam format yang rapi
    public void displayRequests() {
        // Print header
        System.out.println("=== Daftar Request Alokasi Energi ===");

        // Traversal dan print setiap request
        Node curr = head;  // Mulai dari head
        int index = 1;     // Counter untuk nomor urut

        // Loop sampai akhir list
        while (curr != null) {
            // Print nomor urut dan data request menggunakan toString()
            System.out.println("[" + index + "] " + curr.data.toString());

            // Increment counter dan lanjut ke node berikutnya
            index++;
            curr = curr.next;
        }

        // Print footer
        System.out.println("=====================================");
    }

    // [SOAL 6] Method untuk menghitung jumlah total request dalam list
    public int countRequests() {
        int count = 0;     // Counter untuk jumlah node
        Node curr = head;  // Mulai dari head

        // Traversal seluruh list dan hitung jumlah node
        while (curr != null) {
            count++;           // Increment counter
            curr = curr.next;  // Pindah ke node berikutnya
        }

        // Return total jumlah request
        return count;
    }
}

public class Main {
    public static void main(String[] args) {
        // Buat instance SortedLinkedList untuk list utama
        SortedLinkedList a = new SortedLinkedList();

        // Insert data awal ke list a
        a.insertRequest(new Request("Bright Gas Retail", "APP-00542", "LPG 12kg", 2025));
        a.insertRequest(new Request("Energi Nusantara", "APP-01203", "LPG 50kg", 2025));
        a.insertRequest(new Request("Prima Gas", "APP-00103", "LPG 12kg", 2025));
        a.insertRequest(new Request("Samudra LNG", "APP-01888", "LNG", 2025));

        // Insert request duplikat - seharusnya replace data, bukan menambah node
        a.insertRequest(new Request("Prima Gas+", "APP-00103", "LPG 12kg", 2026));

        // Hapus request dengan ticketNumber "APP-01888"
        a.removeByTicket("APP-01888");

        // Buat list kedua untuk testing merge
        SortedLinkedList b = new SortedLinkedList();
        b.insertRequest(new Request("Mandiri Gas", "APP-00009", "LPG 3kg", 2025));
        b.insertRequest(new Request("Kirana Energi", "APP-01777", "LPG 12kg", 2025));
        b.insertRequest(new Request("Energi Nusantara+", "APP-01203", "LPG 50kg", 2026));

        // Gabungkan list b ke list a
        a.mergeFrom(b);

        // Tampilkan semua request dalam list a
        a.displayRequests();

        // Tampilkan total jumlah request
        System.out.println("Total: " + a.countRequests() + " requests");

        // Cari dan tampilkan jumlah request untuk tahun 2025
        System.out.println("Data tahun 2025: " + a.findByYear(2025).size() + " request(s)");
    }
}